{
  "$defs": {
    "ClinicianMessage": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ClinicianMessage",
      "type": "object"
    },
    "HubCmd": {
      "additionalProperties": false,
      "properties": {
        "clinician_message": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClinicianMessage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phq9_due": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ask PHQ-9 in the next ritual (spoken mode)",
          "title": "Phq9 Due"
        },
        "say": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "text-mode user utterance (sim/demo)",
          "title": "Say"
        },
        "set_ritual_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Set Ritual Time"
        },
        "start_ritual": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ritual"
        },
        "suggest_nudge": {
          "anyOf": [
            {
              "$ref": "#/$defs/SuggestNudge"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "HubCmd",
      "type": "object"
    },
    "SuggestNudge": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "enum": [
            "breathe",
            "drum",
            "daylight_walk",
            "friend_ping",
            "icbt_exercise"
          ],
          "title": "Arm",
          "type": "string"
        }
      },
      "required": [
        "arm"
      ],
      "title": "SuggestNudge",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "home_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Home Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/HubCmd"
    },
    "quality": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality"
    },
    "sim": {
      "default": false,
      "title": "Sim",
      "type": "boolean"
    },
    "source": {
      "enum": [
        "head",
        "sensors",
        "hub",
        "friendlink",
        "glasses",
        "laptop",
        "cloud",
        "sim"
      ],
      "title": "Source",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "home_id",
    "source",
    "type",
    "payload"
  ],
  "title": "Envelope<cmd.hub>",
  "type": "object"
}
