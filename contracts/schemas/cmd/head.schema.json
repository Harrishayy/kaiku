{
  "$defs": {
    "HeadCmd": {
      "additionalProperties": false,
      "description": "Robot face + body, all on the Atech head node: eyes/look (Color Display), chest/color/bpm (LED grids),\npan/home/gesture (pan motor, hall homing), purr (speaker tone; no purr motor on the current build).",
      "properties": {
        "activity": {
          "anyOf": [
            {
              "enum": [
                "breathe",
                "drum",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only for a head that runs its own ritual (standalone firmware), the second half of asking twice (D58): the person asked Kaiku in words for this activity; for the next 20 s a press of the ear starts it (the head goes straight to that step) instead of doing what a press does in the current step. none = no longer. Ignored while idle",
          "title": "Activity"
        },
        "bpm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 300,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "for pan_mode=sway or chest=breathe",
          "title": "Bpm"
        },
        "chest": {
          "anyOf": [
            {
              "enum": [
                "off",
                "breathe",
                "glow",
                "pulse"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chest"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "drum": {
          "anyOf": [
            {
              "enum": [
                "hold",
                "end"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only for a head that runs its own ritual (standalone firmware): hold = the hub runs the drum phase now (stay in the drum step, keep reporting taps, no own timer, obey eyes / pan_mode sway / bpm); end = it is over, go on. Re-sent at least every 5 s; 10 s without one = back to the head's own timer. Ignored by a hub-driven head",
          "title": "Drum"
        },
        "eyes": {
          "anyOf": [
            {
              "enum": [
                "neutral",
                "happy",
                "sleepy",
                "wide",
                "listening",
                "thinking",
                "soft"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eyes"
        },
        "gesture": {
          "anyOf": [
            {
              "enum": [
                "look_left",
                "look_right",
                "shake"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "timed motor pulse, then home (no position feedback)",
          "title": "Gesture"
        },
        "home": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home"
        },
        "look": {
          "anyOf": [
            {
              "$ref": "#/$defs/LookAt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mic": {
          "anyOf": [
            {
              "enum": [
                "open",
                "close"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "open = send the head's microphone as PCM frames on audio/head/mic (only while a conversation the person started is open); close = stop. Re-sent at least every 3 s; the head closes by itself after 10 s without one. Half-duplex: no frames while its speaker plays and about 250 ms after",
          "title": "Mic"
        },
        "pan": {
          "anyOf": [
            {
              "$ref": "#/$defs/PanTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pan_mode": {
          "anyOf": [
            {
              "enum": [
                "track",
                "still",
                "sway"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pan Mode"
        },
        "purr": {
          "anyOf": [
            {
              "$ref": "#/$defs/Purr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ritual": {
          "anyOf": [
            {
              "enum": [
                "next",
                "end"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only for a head that runs its own ritual (standalone firmware): next = go on to the next step now (she answered the dial question in words instead of with the ear); end = she asked to stop: back to idle now, quietly. Ignored while idle",
          "title": "Ritual"
        },
        "show": {
          "anyOf": [
            {
              "enum": [
                "help",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "help = the head shows the helpline's name and number and the emergency number on its own screen, from constants compiled into the firmware, until `none`, a new ritual, or 10 minutes; never a sound. Sent by the hub's crisis path only",
          "title": "Show"
        }
      },
      "title": "HeadCmd",
      "type": "object"
    },
    "LookAt": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": -1,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": -1,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "LookAt",
      "type": "object"
    },
    "PanTarget": {
      "additionalProperties": false,
      "properties": {
        "speed": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Speed",
          "type": "number"
        },
        "target_deg": {
          "title": "Target Deg",
          "type": "number"
        }
      },
      "required": [
        "target_deg"
      ],
      "title": "PanTarget",
      "type": "object"
    },
    "Purr": {
      "additionalProperties": false,
      "properties": {
        "ms": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Ms",
          "type": "integer"
        }
      },
      "required": [
        "ms"
      ],
      "title": "Purr",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "home_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Home Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/HeadCmd"
    },
    "quality": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality"
    },
    "sim": {
      "default": false,
      "title": "Sim",
      "type": "boolean"
    },
    "source": {
      "enum": [
        "head",
        "sensors",
        "hub",
        "friendlink",
        "glasses",
        "laptop",
        "phone",
        "cloud",
        "sim"
      ],
      "title": "Source",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "home_id",
    "source",
    "type",
    "payload"
  ],
  "title": "Envelope<cmd.head>",
  "type": "object"
}
