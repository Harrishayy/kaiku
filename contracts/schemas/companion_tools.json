      },
      "surfaces": [
        "robot",
        "glasses",
        "iphone",
        "mac",
        "web"
      ]
    },
    "start_phq9": {
      "description": "Start the two-weekly questionnaire (read items verbatim; code scores it).",
      "executor": "device",
      "parameters": {
        "properties": {},
        "type": "object"
      },
      "surfaces": [
        "robot",
        "iphone",
        "mac",
        "web"
      ]
    },
    "suggest_nudge": {
      "description": "Get today's one small suggestion (phrase it, never change it).",
      "executor": "cloud",
      "parameters": {
        "properties": {},
        "type": "object"
      },
      "surfaces": [
        "robot",
        "glasses",
        "iphone",
        "mac",
