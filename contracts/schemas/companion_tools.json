  ],
  "memory_categories": [
    "name",
    "people",
    "places",
    "likes",
    "what_helps",
    "plans",
    "preference"
  ],
  "skill_of_intent": {
    "break": "breathe",
    "breathe": "breathe",
    "checkin": "weather_check",
    "ritual": "morning_ritual",
    "talk": null,
    "walk": "walk_companion"
  },
  "skills": [
    "morning_ritual",
    "weather_check",
    "walk_companion",
    "breathe"
  ],
  "surfaces": [
    "robot",
    "glasses",
    "iphone",
    "mac",
    "web"
  ],
  "tools": {
    "ask_mind": {
      "description": "Ask Kaiku's shared Gemma mind for missing or conflicting personal knowledge, planning, care or deeper emotional reasoning. Use prepared context directly when sufficient. Returns an answer to say in your own words (may say to ask the person or the care team). kind: fact | care | memory | plan | emotional.",
      "executor": "cloud",
      "parameters": {
        "properties": {
          "kind": {
            "enum": [
              "fact",
              "care",
              "memory",
              "plan",
              "emotional"
            ],
            "type": "string"
          },
          "question": {
            "maxLength": 300,
            "type": "string"
          }
        },
        "required": [
          "question",
          "kind"
        ],
        "type": "object"
      },
      "surfaces": [
        "robot",
        "glasses",
        "iphone",
        "mac",
        "web"
      ]
    },
    "end_session": {
      "description": "Close the session politely. Optionally leave one open thread to pick up next time on any device (e.g. skill walk_companion, topic \"the walk by the lake\").",
      "executor": "cloud",
      "parameters": {
        "properties": {
          "follow_up": {
            "properties": {
              "skill": {
                "enum": [
                  "morning_ritual",
                  "weather_check",
                  "walk_companion",
                  "breathe"
                ],
                "type": "string"
              },
              "topic": {
                "maxLength": 80,
                "type": "string"
              }
            },
            "required": [
              "skill",
              "topic"
            ],
            "type": "object"
          },
          "outcome": {
            "enum": [
              "completed",
              "skipped",
              "ended_early"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "surfaces": [
        "robot",
        "glasses",
        "iphone",
        "mac",
        "web"
      ]
    },
    "express": {
      "description": "Show a feeling on Kaiku's face and body.",
      "executor": "device",
      "parameters": {
        "properties": {
          "feeling": {
            "enum": [
              "happy",
              "curious",
              "sleepy",
              "cozy",
              "proud"
            ],
            "type": "string"
          }
        },
        "required": [
          "feeling"
        ],
        "type": "object"
      },
      "surfaces": [
        "robot",
        "glasses",
        "iphone",
        "mac",
        "web"
      ]
    },
    "feel": {
      "behavior": "NON_BLOCKING",
      "description": "Tell Kaiku's mind about a clear feeling or a piece of news in what the person just said or how they sounded. Once per clear shift, never every turn; keep talking warmly while it runs. Returns how to meet it for this person: stance, depth (brief = an ordinary moment, keep the chat small; stay = do not close, stay as long as they want), one thing the record knows (recall) and at most one small thing you may offer once (may_offer). heard.via: voice when you heard them say it, text when it was typed.",
      "executor": "cloud",
      "parameters": {
        "properties": {
          "about": {
            "maxLength": 80,
            "type": "string"
          },
          "heard": {
            "properties": {
              "energy": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "tone": {
                "items": {
                  "enum": [
                    "flat",
                    "tense",
                    "tearful",
                    "irritable",
                    "warm",
                    "playful",
                    "calm"
                  ],
                  "type": "string"
                },
                "maxItems": 2,
                "type": "array"
              },
              "valence": {
                "enum": [
                  "low",
                  "neutral",
                  "bright"
                ],
                "type": "string"
              },
              "via": {
                "enum": [
                  "voice",
                  "text"
                ],
                "type": "string"
              }
            },
            "required": [
              "valence"
            ],
            "type": "object"
          },
          "kind": {
            "enum": [
              "sad_news",
              "good_news",
              "flat",
              "angry",
              "worried",
              "lonely",
              "proud",
              "relief",
              "other"
            ],
            "type": "string"
          },
          "said": {
            "maxLength": 300,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "heard"
        ],
        "type": "object"
      },
      "surfaces": [
        "robot",
        "glasses",
        "iphone",
        "mac",
        "web"
      ]
    },
    "forget": {
      "description": "The person said \"don't remember that\" (scope last) or wants everything forgotten (all).",
      "executor": "cloud",
      "parameters": {
        "properties": {
          "scope": {
            "enum": [
              "last",
              "all"
            ],
            "type": "string"
          }
        },
        "required": [
          "scope"
        ],
        "type": "object"
      },
      "surfaces": [
        "robot",
        "glasses",
        "iphone",
        "mac",
        "web"
      ]
    },
    "log_walk_moment": {
      "description": "The person found something on the light hunt (e.g. something green).",
      "executor": "device",
      "parameters": {
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "surfaces": [
        "glasses"
      ]
    },
    "look_at_this": {
      "description": "Check whether you can see through the glasses camera right now, and get one fresh picture if you can. Only works while the person has turned on Let Kaiku see; otherwise the result says you cannot see.",
      "executor": "device",
      "parameters": {
        "properties": {},
        "type": "object"
      },
      "surfaces": [
        "glasses"
      ]
    },
    "recall": {
      "description": "Look up to 3 things the person told Kaiku before about a topic.",
      "executor": "cloud",
      "parameters": {
        "properties": {
          "topic": {
            "type": "string"
          }
        },
        "required": [
          "topic"
        ],
        "type": "object"
      },
      "surfaces": [
        "robot",
        "glasses",
        "iphone",
        "mac",
        "web"
      ]
    },
    "record_dial": {
      "description": "Record the person's 1-5 answer to a dial question.",
      "executor": "device",
      "parameters": {
        "properties": {
          "item": {
            "enum": [
              "mood",
              "energy",
              "sleep"
            ],
            "type": "string"
          },
          "value": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "item",
          "value"
        ],
        "type": "object"
      },
      "surfaces": [
        "robot",
        "glasses",
        "iphone",
        "mac",
        "web"
      ]
    },
    "remember": {
      "description": "Keep a short fact the person told you and wants kept (stored only if allowed; they can see and delete it). Never health details. In a conversation always pass `said`: the person's own words it comes from. Without it, or if it does not contain the fact, nothing is stored.",
      "executor": "cloud",
      "parameters": {
        "properties": {
          "category": {
            "enum": [
              "name",
              "people",
              "places",
              "likes",
              "what_helps",
              "plans",
              "preference"
            ],
            "type": "string"
          },
          "said": {
            "maxLength": 300,
            "type": "string"
          },
          "text": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "category",
          "text"
        ],
        "type": "object"
      },
      "surfaces": [
        "robot",
        "glasses",
        "iphone",
        "mac",
        "web"
      ]
    },
    "send_friend_ping": {
