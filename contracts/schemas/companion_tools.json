                    "flat",
                    "tense",
                    "tearful",
                    "irritable",
                    "warm",
                    "playful",
                    "calm"
                  ],
                  "type": "string"
                },
                "maxItems": 2,
                "type": "array"
              },
              "valence": {
                "enum": [
                  "low",
                  "neutral",
                  "bright"
                ],
                "type": "string"
              },
              "via": {
                "enum": [
                  "voice",
                  "text"
                ],
                "type": "string"
              }
            },
            "required": [
