{
  "$defs": {
    "Garden": {
      "additionalProperties": false,
      "description": "Reward only (no data). plants = finished interactions in the last 14 days; resting after 3 quiet days.\nIt never wilts and there is no streak counter. `days` = the last 14 local days, oldest first (one plot each).",
      "properties": {
        "days": {
          "items": {
            "$ref": "#/$defs/GardenDay"
          },
          "title": "Days",
          "type": "array"
        },
        "plants": {
          "default": 0,
          "minimum": 0,
          "title": "Plants",
          "type": "integer"
        },
        "resting": {
          "default": false,
          "title": "Resting",
          "type": "boolean"
        }
      },
      "title": "Garden",
      "type": "object"
    },
    "GardenDay": {
      "additionalProperties": false,
      "description": "One plot of the garden: what was done together that local day (kinds: ritual, drum_session, play_session,\nouting, friend_link, weather_check). A quiet day is an empty plot, never a wilted one.",
      "properties": {
        "count": {
          "default": 0,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "kinds": {
          "items": {
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        }
      },
      "required": [
        "date"
      ],
      "title": "GardenDay",
      "type": "object"
    },
    "HelpStat": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "title": "Activity",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "mean_effect": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "mean reward 0..1",
          "title": "Mean Effect"
        },
        "tries": {
          "minimum": 0,
          "title": "Tries",
          "type": "integer"
        }
      },
      "required": [
        "activity",
        "label",
        "tries"
      ],
      "title": "HelpStat",
      "type": "object"
    },
    "Highlight": {
      "additionalProperties": false,
      "description": "One line for \"Your days\": a good moment or a gentle note about a harder day. Plain, friendly, never clinical.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "kind": {
          "enum": [
            "good",
            "hard"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "enum": [
            "robot",
            "glasses",
            "laptop",
            "wearable"
          ],
          "title": "Source",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "date",
        "kind",
        "text",
        "source"
      ],
      "title": "Highlight",
      "type": "object"
    },
    "Mascot": {
      "additionalProperties": false,
      "description": "Kaiku's ambient mood (plan 02 §2): a pure function of the consensus state, computed once in the cloud so every\nsurface shows the same thing. Never sad or worried at the person: stable -> idle/happy, watch -> cozy,\nneeds_call -> cozy + the nurse-chat offer, safety -> \"crisis\" (clients show the scripted crisis screen from\nconfig/safety_phrases.toml: no animation, no character lines; line_key is then null).",
      "properties": {
        "line_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "key in config/voice_lines.toml (GET /v1/voice/{key})",
          "title": "Line Key"
        },
        "mood": {
          "enum": [
            "idle",
            "happy",
            "cozy",
            "crisis"
          ],
          "title": "Mood",
          "type": "string"
        }
      },
      "required": [
        "mood"
      ],
      "title": "Mascot",
      "type": "object"
    },
    "NudgeResponse": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "enum": [
            "breathe",
            "drum",
            "daylight_walk",
            "friend_ping",
            "icbt_exercise"
          ],
          "title": "Arm",
          "type": "string"
        },
        "probs": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probs",
          "type": "object"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "arm",
        "reason"
      ],
      "title": "NudgeResponse",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Person-facing view. Plain language, never alarming.",
  "properties": {
    "garden": {
      "$ref": "#/$defs/Garden"
    },
    "highlights": {
      "description": "last 7 days, newest first",
      "items": {
        "$ref": "#/$defs/Highlight"
      },
      "title": "Highlights",
      "type": "array"
    },
    "home_id": {
      "title": "Home Id",
      "type": "string"
    },
    "last_week": {
      "description": "short plain-language lines",
      "items": {
        "type": "string"
      },
      "title": "Last Week",
      "type": "array"
    },
    "mascot": {
      "$ref": "#/$defs/Mascot"
    },
    "next_suggestion": {
      "anyOf": [
        {
          "$ref": "#/$defs/NudgeResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "phq9_due": {
      "default": false,
      "title": "Phq9 Due",
      "type": "boolean"
    },
    "sim": {
      "default": false,
      "title": "Sim",
      "type": "boolean"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "what_helps": {
      "items": {
        "$ref": "#/$defs/HelpStat"
      },
      "title": "What Helps",
      "type": "array"
    }
  },
  "required": [
    "home_id",
    "summary"
  ],
  "title": "MeResponse",
  "type": "object"
}
