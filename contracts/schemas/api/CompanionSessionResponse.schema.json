{
  "$defs": {
    "ChatShape": {
      "additionalProperties": false,
      "description": "How this conversation should run, for the device: the same guidance the model reads in its instruction.",
      "properties": {
        "depth": {
          "enum": [
            "brief",
            "stay"
          ],
          "title": "Depth",
          "type": "string"
        },
        "open_items": {
          "description": "check-in dials not answered today",
          "items": {
            "enum": [
              "mood",
              "energy",
              "sleep"
            ],
            "type": "string"
          },
          "title": "Open Items",
          "type": "array"
        },
        "purpose": {
          "enum": [
            "talk",
            "check_in",
            "walk",
            "ritual"
          ],
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "depth"
      ],
      "title": "ChatShape",
      "type": "object"
    },
    "CompanionTool": {
      "additionalProperties": false,
      "properties": {
        "behavior": {
          "anyOf": [
            {
              "const": "NON_BLOCKING",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Live asynchronous function calling: declare it so and answer with the result's `scheduling`",
          "title": "Behavior"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "title": "CompanionTool",
      "type": "object"
    },
    "ContextCard": {
      "additionalProperties": false,
      "properties": {
        "agreed": {
          "description": "activities they said yes to today on any device and whether each is done (D50); each is carried once per state, so Kaiku is glad or asks gently once",
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Agreed",
          "type": "array"
        },
        "care_info": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Care Info"
        },
        "chat_depth": {
          "anyOf": [
            {
              "enum": [
                "brief",
                "stay"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "check-in sessions: how the chat should open",
          "title": "Chat Depth"
        },
        "done_today": {
          "description": "on any surface",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Done Today",
          "type": "array"
        },
        "dont_remember": {
          "default": false,
          "title": "Dont Remember",
          "type": "boolean"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only if the person told Kaiku their name",
          "title": "First Name"
        },
        "focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "today's focus, chosen by the daily reflection from fixed options",
          "title": "Focus"
        },
        "intent": {
          "default": "talk",
          "enum": [
            "ritual",
            "checkin",
            "walk",
            "breathe",
            "talk",
            "break"
          ],
          "title": "Intent",
          "type": "string"
        },
        "language": {
          "default": "en",
          "enum": [
            "en",
            "fi",
            "sv"
          ],
          "title": "Language",
          "type": "string"
        },
        "last_reflection": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastReflection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memories": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Memories",
          "type": "array"
        },
        "open_items": {
          "description": "check-in sessions: dials not answered today; at most one is woven into the chat",
          "items": {
            "enum": [
              "mood",
              "energy",
              "sleep"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Open Items",
          "type": "array"
        },
        "open_thread": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "topic left open on any surface",
          "title": "Open Thread"
        },
        "others_present": {
          "default": false,
          "title": "Others Present",
          "type": "boolean"
        },
        "outdoor_likes": {
          "description": "walk sessions: outdoor things and places the person told Kaiku they like, in their words (notebook)",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Outdoor Likes",
          "type": "array"
        },
        "phq9_due": {
          "default": false,
          "title": "Phq9 Due",
          "type": "boolean"
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "talk",
                "check_in",
                "walk",
                "ritual"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set when the device said why it opened the session",
          "title": "Purpose"
        },
        "quieter_in": {
          "description": "today's tasks in which the face signs counted with their opt-in were clearly below their own usual (D52, rule in mind/face_cue.py). An enum and nothing else: the instruction turns it into a cue to go gently and never to mention their face or a camera; no number, no state and no word about how they looked ever crosses",
          "items": {
            "enum": [
              "games",
              "check_in"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Quieter In",
          "type": "array"
        },
        "recent_reflection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how the latest reflection with Kaiku went, as a level and themes only (never the words), so Kaiku can be gentle about it",
          "title": "Recent Reflection"
        },
        "routines": {
          "description": "e.g. \"usually walks on Tuesdays\"",
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Routines",
          "type": "array"
        },
        "source_context": {
          "description": "prepared source-labelled activity facts; no clinical metrics or raw content",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Source Context",
          "type": "array"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "today's bandit suggestion, phrased",
          "title": "Suggestion"
        },
        "time_of_day": {
          "enum": [
            "morning",
            "afternoon",
            "evening",
            "night"
          ],
          "title": "Time Of Day",
          "type": "string"
        },
        "today_facts": {
          "description": "plain facts the person recorded themselves today, in everyday words (\"a short night\"); never a number or a judgement",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Today Facts",
          "type": "array"
        },
        "tone": {
          "default": "steady",
          "enum": [
            "steady",
            "gentle",
            "extra-gentle"
          ],
          "title": "Tone",
          "type": "string"
        },
        "walk_style": {
          "anyOf": [
            {
              "enum": [
                "quiet",
                "playful",
                "chatty"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "walk sessions: how Kaiku walks with them",
          "title": "Walk Style"
        },
        "weather_word": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weather Word"
        }
      },
      "required": [
        "time_of_day"
      ],
      "title": "ContextCard",
      "type": "object"
    },
    "ExpressionCueRules": {
      "additionalProperties": false,
      "description": "How a device decides that a visible expression cue holds (D60; config `[expression_cue]`). The device runs\nthe rule on numbers in memory; this is only its thresholds, so they can be tuned without a new app build.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_per_conversation": {
          "default": 3,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Per Conversation",
          "type": "integer"
        },
        "min_gap_s": {
          "default": 90,
          "description": "at most one cue handed to the conversation in this long",
          "maximum": 3600,
          "minimum": 0,
          "title": "Min Gap S",
          "type": "number"
        },
        "rise": {
          "default": 0.15,
          "description": "how far above the person's own level in this task (0 to 1 strengths)",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Rise",
          "type": "number"
        },
        "settle_s": {
          "default": 8,
          "description": "face time before anything can hold: the person's own level in this task is taken from it",
          "maximum": 600,
          "minimum": 5,
          "title": "Settle S",
          "type": "number"
        },
        "speak": {
          "default": true,
          "description": "may a cue put ONE quiet context turn into the open conversation",
          "title": "Speak",
          "type": "boolean"
        },
        "sustain_s": {
          "default": 4.5,
          "description": "how long it must hold without a break",
          "maximum": 120,
          "minimum": 2,
          "title": "Sustain S",
          "type": "number"
        }
      },
      "title": "ExpressionCueRules",
      "type": "object"
    },
    "HeardTone": {
      "additionalProperties": false,
      "description": "How a conversation sounded to the model that was in it, reported through the `feel` tool. An observation\nby a model, never a measurement and never a state. `model_heard`: the native-audio voice model heard the\nperson speak. `model_read`: it went by their typed or transcribed words only.",
      "properties": {
        "energy": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy"
        },
        "moments": {
          "default": 1,
          "description": "how many times a feeling was noticed in that conversation",
          "minimum": 1,
          "title": "Moments",
          "type": "integer"
        },
        "provenance": {
          "enum": [
            "model_heard",
            "model_read"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "tone": {
          "items": {
            "enum": [
              "flat",
              "tense",
              "tearful",
              "irritable",
              "warm",
              "playful",
              "calm"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Tone",
          "type": "array"
        },
        "valence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "neutral",
                "bright"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valence"
        }
      },
      "required": [
        "provenance"
      ],
      "title": "HeardTone",
      "type": "object"
    },
    "LastReflection": {
      "additionalProperties": false,
      "description": "How the latest talk with Kaiku went: a level and themes, never the words.",
      "properties": {
        "declined": {
          "default": false,
          "description": "they did not want to talk or asked to stop",
          "title": "Declined",
          "type": "boolean"
        },
        "energy": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy"
        },
        "heard": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeardTone"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "themes": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Themes",
          "type": "array"
        },
        "tone": {
          "description": "from their words (rules or Gemma)",
          "items": {
            "enum": [
              "flat",
              "tense",
              "tearful",
              "irritable",
              "warm",
              "playful",
              "calm"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Tone",
          "type": "array"
        },
        "valence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "neutral",
                "bright"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valence"
        },
        "when": {
          "description": "e.g. \"yesterday evening\", \"this morning\"",
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "when"
      ],
      "title": "LastReflection",
      "type": "object"
    },
    "LiveToken": {
      "additionalProperties": false,
      "description": "Gemini Live ephemeral token: use `token` as the API key for ONE Live session (v1beta). Start within\n`new_session_expires_at`; the session may run until `expires_at`.",
      "properties": {
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "new_session_expires_at": {
          "format": "date-time",
          "title": "New Session Expires At",
          "type": "string"
        },
        "token": {
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "token",
        "expires_at",
        "new_session_expires_at"
      ],
      "title": "LiveToken",
      "type": "object"
    },
    "VisionLookRules": {
      "additionalProperties": false,
      "description": "How a device picks the few pictures Kaiku's own model may look at during a check-in (D65; config\n`[vision_look]`). Sent only where the service can do it and only matters with the person's opt-in on that\ndevice. The device takes them in memory, sends them once, and keeps none, also when the send fails.",
      "properties": {
        "frames": {
          "default": 3,
          "description": "pictures per check-in, at most",
          "maximum": 8,
          "minimum": 1,
          "title": "Frames",
          "type": "integer"
        },
        "jpeg_quality": {
          "default": 0.6,
          "maximum": 0.9,
          "minimum": 0.2,
          "title": "Jpeg Quality",
          "type": "number"
        },
        "max_edge_px": {
          "default": 256,
          "description": "the longer side after downscaling",
          "maximum": 768,
          "minimum": 64,
          "title": "Max Edge Px",
          "type": "integer"
        },
        "min_interval_s": {
          "default": 12,
          "description": "at least this long between two",
          "maximum": 3600,
          "minimum": 1,
          "title": "Min Interval S",
          "type": "number"
        },
        "settle_s": {
          "default": 6,
          "description": "camera time before the first one",
          "maximum": 600,
          "minimum": 0,
          "title": "Settle S",
          "type": "number"
        }
      },
      "title": "VisionLookRules",
      "type": "object"
    },
    "WalkGuide": {
      "additionalProperties": false,
      "description": "CompanionSessionResponse.walk: how the device keeps a walk going. A Live session only answers input, so the\ndevice nudges: it sends `look_prompt` as a context text turn every `look_every_s` while the camera is on and\nnobody is speaking, and `quiet_prompt` once after `quiet_after_s` without anyone speaking. Null = that nudge\nis not used in this style. Values: config/kaiku.toml [walk].\nKaiku answers a nudge in words only when there is something to say. A declined nudge has no words but is not\nalways silent (real sessions: often a second or two of non-speech sound, transcribed `<no speech>` or `×`),\nso the device holds the audio of a nudge's reply until its first output transcription fragment and plays it\nonly when that fragment has a real word.",
      "properties": {
        "look_every_s": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Look Every S"
        },
        "look_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Look Prompt"
        },
        "quiet_after_s": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quiet After S"
        },
        "quiet_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quiet Prompt"
        },
        "style": {
          "enum": [
            "quiet",
            "playful",
            "chatty"
          ],
          "title": "Style",
          "type": "string"
        }
      },
      "required": [
        "style"
      ],
      "title": "WalkGuide",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "POST /v1/companion/session — everything a device needs to open Gemini Live as Kaiku. `live_token` is null\nwhen Live is unavailable: the device reports unavailability and keeps the microphone closed.",
  "properties": {
    "chat_shape": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChatShape"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "present when the request named a purpose"
    },
    "context_card": {
      "$ref": "#/$defs/ContextCard"
    },
    "context_refresh_seconds": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "poll interval for consented source updates during an active conversation",
      "title": "Context Refresh Seconds"
    },
    "expression_cue": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExpressionCueRules"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "thresholds for visible expression cues on this device (D60); null = the device does not look for them in this conversation"
    },
    "idle_end_s": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the device ends the conversation by itself after this long with nobody speaking (an open microphone in a pocket); longer on a walk",
      "title": "Idle End S"
    },
    "live_setup": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Kaiku's recommended Live BidiGenerateContentSetup (REST camelCase; the token locks only the model): model, voice, system instruction, tools, automatic VAD + barge-in, transcriptions. Send it as the first frame {setup: live_setup}; clients must apply this complete setup.",
      "title": "Live Setup"
    },
    "live_token": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiveToken"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "max_session_seconds": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "client-enforced maximum active session duration",
      "title": "Max Session Seconds"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "persona_version": {
      "title": "Persona Version",
      "type": "string"
    },
    "safety_phrases_version": {
      "title": "Safety Phrases Version",
      "type": "string"
    },
    "session_id": {
      "description": "pass to /v1/companion/tool and /v1/companion/episode",
      "title": "Session Id",
      "type": "string"
    },
    "system_instruction": {
      "title": "System Instruction",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/CompanionTool"
      },
      "title": "Tools",
      "type": "array"
    },
    "vision_look": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisionLookRules"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "how to pick the few pictures Kaiku's own model may look at in this check-in (D65); null = the service does not offer it here. The device still sends none without the person's own opt-in"
    },
    "voice": {
      "title": "Voice",
      "type": "string"
    },
    "walk": {
      "anyOf": [
        {
          "$ref": "#/$defs/WalkGuide"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "present when the purpose is walk"
    }
  },
  "required": [
    "session_id",
    "model",
    "voice",
    "system_instruction",
    "tools",
    "context_card",
    "persona_version",
    "safety_phrases_version"
  ],
  "title": "CompanionSessionResponse",
  "type": "object"
}
