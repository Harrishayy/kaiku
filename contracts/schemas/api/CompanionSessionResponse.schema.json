{
  "$defs": {
    "ChatShape": {
      "additionalProperties": false,
      "description": "How this conversation should run, for the device: the same guidance the model reads in its instruction.",
      "properties": {
        "depth": {
          "enum": [
            "brief",
            "stay"
          ],
          "title": "Depth",
          "type": "string"
        },
        "open_items": {
          "description": "check-in dials not answered today",
          "items": {
            "enum": [
              "mood",
              "energy",
              "sleep"
            ],
            "type": "string"
          },
          "title": "Open Items",
          "type": "array"
        },
        "purpose": {
          "enum": [
            "talk",
            "check_in",
            "walk",
            "ritual"
          ],
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "depth"
      ],
      "title": "ChatShape",
      "type": "object"
    },
    "CompanionTool": {
      "additionalProperties": false,
      "properties": {
        "behavior": {
          "anyOf": [
            {
              "const": "NON_BLOCKING",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Live asynchronous function calling: declare it so and answer with the result's `scheduling`",
          "title": "Behavior"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "title": "CompanionTool",
      "type": "object"
    },
    "ContextCard": {
      "additionalProperties": false,
      "properties": {
        "care_info": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Care Info"
        },
        "chat_depth": {
          "anyOf": [
            {
              "enum": [
                "brief",
                "stay"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "check-in sessions: how the chat should open",
          "title": "Chat Depth"
        },
        "done_today": {
          "description": "on any surface",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Done Today",
          "type": "array"
        },
        "dont_remember": {
          "default": false,
          "title": "Dont Remember",
          "type": "boolean"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only if the person told Kaiku their name",
          "title": "First Name"
        },
        "focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "today's focus, chosen by the daily reflection from fixed options",
          "title": "Focus"
        },
        "intent": {
          "default": "talk",
          "enum": [
            "ritual",
            "checkin",
            "walk",
            "breathe",
            "talk",
            "break"
          ],
          "title": "Intent",
          "type": "string"
        },
        "language": {
          "default": "en",
          "enum": [
            "en",
            "fi",
            "sv"
          ],
          "title": "Language",
          "type": "string"
        },
        "last_reflection": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastReflection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memories": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Memories",
          "type": "array"
        },
        "open_items": {
          "description": "check-in sessions: dials not answered today; at most one is woven into the chat",
          "items": {
            "enum": [
              "mood",
              "energy",
              "sleep"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Open Items",
          "type": "array"
        },
        "open_thread": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "topic left open on any surface",
          "title": "Open Thread"
        },
        "others_present": {
          "default": false,
          "title": "Others Present",
          "type": "boolean"
        },
        "phq9_due": {
          "default": false,
          "title": "Phq9 Due",
          "type": "boolean"
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "talk",
                "check_in",
                "walk",
                "ritual"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set when the device said why it opened the session",
          "title": "Purpose"
        },
        "recent_reflection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how the latest reflection with Kaiku went, as a level and themes only (never the words), so Kaiku can be gentle about it",
          "title": "Recent Reflection"
        },
        "routines": {
          "description": "e.g. \"usually walks on Tuesdays\"",
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Routines",
          "type": "array"
        },
        "source_context": {
          "description": "prepared source-labelled activity facts; no clinical metrics or raw content",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Source Context",
          "type": "array"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "today's bandit suggestion, phrased",
          "title": "Suggestion"
        },
        "time_of_day": {
          "enum": [
            "morning",
            "afternoon",
            "evening",
            "night"
          ],
          "title": "Time Of Day",
          "type": "string"
        },
        "today_facts": {
          "description": "plain facts the person recorded themselves today, in everyday words (\"a short night\"); never a number or a judgement",
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Today Facts",
          "type": "array"
        },
        "tone": {
          "default": "steady",
          "enum": [
            "steady",
            "gentle",
            "extra-gentle"
          ],
          "title": "Tone",
          "type": "string"
        },
        "weather_word": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weather Word"
        }
      },
      "required": [
        "time_of_day"
      ],
      "title": "ContextCard",
      "type": "object"
    },
    "HeardTone": {
      "additionalProperties": false,
      "description": "How a conversation sounded to the model that was in it, reported through the `feel` tool. An observation\nby a model, never a measurement and never a state. `model_heard`: the native-audio voice model heard the\nperson speak. `model_read`: it went by their typed or transcribed words only.",
      "properties": {
        "energy": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy"
        },
        "moments": {
          "default": 1,
          "description": "how many times a feeling was noticed in that conversation",
          "minimum": 1,
          "title": "Moments",
          "type": "integer"
        },
        "provenance": {
          "enum": [
            "model_heard",
            "model_read"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "tone": {
          "items": {
            "enum": [
              "flat",
              "tense",
              "tearful",
              "irritable",
              "warm",
              "playful",
              "calm"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Tone",
          "type": "array"
        },
        "valence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "neutral",
                "bright"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valence"
        }
      },
      "required": [
        "provenance"
      ],
      "title": "HeardTone",
      "type": "object"
    },
    "LastReflection": {
      "additionalProperties": false,
      "description": "How the latest talk with Kaiku went: a level and themes, never the words.",
      "properties": {
        "declined": {
          "default": false,
          "description": "they did not want to talk or asked to stop",
          "title": "Declined",
          "type": "boolean"
        },
        "energy": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy"
        },
        "heard": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeardTone"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "themes": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Themes",
          "type": "array"
        },
        "tone": {
          "description": "from their words (rules or Gemma)",
          "items": {
            "enum": [
              "flat",
              "tense",
              "tearful",
              "irritable",
              "warm",
              "playful",
              "calm"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Tone",
          "type": "array"
        },
        "valence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "neutral",
                "bright"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valence"
        },
        "when": {
          "description": "e.g. \"yesterday evening\", \"this morning\"",
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "when"
      ],
      "title": "LastReflection",
      "type": "object"
    },
    "LiveToken": {
      "additionalProperties": false,
      "description": "Gemini Live ephemeral token: use `token` as the API key for ONE Live session (v1beta). Start within\n`new_session_expires_at`; the session may run until `expires_at`.",
      "properties": {
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "new_session_expires_at": {
          "format": "date-time",
          "title": "New Session Expires At",
          "type": "string"
        },
        "token": {
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "token",
        "expires_at",
        "new_session_expires_at"
      ],
      "title": "LiveToken",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "POST /v1/companion/session — everything a device needs to open Gemini Live as Kaiku. `live_token` is null\nwhen Live is unavailable: the device reports unavailability and keeps the microphone closed.",
  "properties": {
    "chat_shape": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChatShape"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "present when the request named a purpose"
    },
    "context_card": {
      "$ref": "#/$defs/ContextCard"
    },
    "context_refresh_seconds": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "poll interval for consented source updates during an active conversation",
      "title": "Context Refresh Seconds"
    },
    "live_setup": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Kaiku's recommended Live BidiGenerateContentSetup (REST camelCase; the token locks only the model): model, voice, system instruction, tools, automatic VAD + barge-in, transcriptions. Send it as the first frame {setup: live_setup}; clients must apply this complete setup.",
      "title": "Live Setup"
    },
    "live_token": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiveToken"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "max_session_seconds": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "client-enforced maximum active session duration",
      "title": "Max Session Seconds"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "persona_version": {
      "title": "Persona Version",
      "type": "string"
    },
    "safety_phrases_version": {
      "title": "Safety Phrases Version",
      "type": "string"
    },
    "session_id": {
      "description": "pass to /v1/companion/tool and /v1/companion/episode",
      "title": "Session Id",
      "type": "string"
    },
    "system_instruction": {
      "title": "System Instruction",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/CompanionTool"
      },
      "title": "Tools",
      "type": "array"
    },
    "voice": {
      "title": "Voice",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "model",
    "voice",
    "system_instruction",
    "tools",
    "context_card",
    "persona_version",
    "safety_phrases_version"
  ],
  "title": "CompanionSessionResponse",
  "type": "object"
}
