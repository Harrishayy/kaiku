    "feel": {
      "items": {
        "$ref": "#/$defs/DebugFeel"
      },
      "title": "Feel",
      "type": "array"
    },
    "intent": {
      "enum": [
        "ritual",
        "checkin",
        "walk",
        "breathe",
        "talk",
        "break"
      ],
      "title": "Intent",
      "type": "string"
    },
    "minutes": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minutes"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "completed",
            "skipped",
            "ended_early",
            "crisis",
            "offline"
