          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "how it ended; null = never closed",
      "title": "Outcome"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    },
    "surface": {
      "enum": [
        "robot",
        "glasses",
        "iphone",
        "mac",
        "web"
      ],
      "title": "Surface",
      "type": "string"
    },
    "tools": {
      "description": "tool names: in call order while the conversation is open, one of each once the device has uploaded it",
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    },
    "tools_in_order": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
