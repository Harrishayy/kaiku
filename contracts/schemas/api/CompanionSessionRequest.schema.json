{
  "additionalProperties": false,
  "properties": {
    "home_id": {
      "title": "Home Id",
      "type": "string"
    },
    "intent": {
      "default": "talk",
      "enum": [
        "ritual",
        "checkin",
        "walk",
        "breathe",
        "talk",
        "break"
      ],
      "title": "Intent",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "enum": [
            "en",
            "fi",
            "sv"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "default: config/kaiku.toml [home].language",
      "title": "Language"
    },
    "others_present": {
      "default": false,
      "title": "Others Present",
      "type": "boolean"
    },
    "purpose": {
      "anyOf": [
        {
          "enum": [
            "talk",
            "check_in",
            "walk",
            "ritual"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "why the conversation was opened. check_in: a small passing chat alongside the periodic check-in (see chat_shape). Omitted = today's behaviour for the intent",
      "title": "Purpose"
    },
    "resume_session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "reuse an open session belonging to this home and surface",
      "title": "Resume Session Id"
    },
    "surface": {
      "enum": [
        "robot",
        "glasses",
        "iphone",
        "mac",
        "web"
      ],
      "title": "Surface",
      "type": "string"
    }
  },
  "required": [
    "surface",
    "home_id"
  ],
  "title": "CompanionSessionRequest",
  "type": "object"
}
