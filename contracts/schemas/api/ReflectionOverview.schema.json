{
  "$defs": {
    "HeardTone": {
      "additionalProperties": false,
      "description": "How a conversation sounded to the model that was in it, reported through the `feel` tool. An observation\nby a model, never a measurement and never a state. `model_heard`: the native-audio voice model heard the\nperson speak. `model_read`: it went by their typed or transcribed words only.",
      "properties": {
        "energy": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy"
        },
        "moments": {
          "default": 1,
          "description": "how many times a feeling was noticed in that conversation",
          "minimum": 1,
          "title": "Moments",
          "type": "integer"
        },
        "provenance": {
          "enum": [
            "model_heard",
            "model_read"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "tone": {
          "items": {
            "enum": [
              "flat",
              "tense",
              "tearful",
              "irritable",
              "warm",
              "playful",
              "calm"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Tone",
          "type": "array"
        },
        "valence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "neutral",
                "bright"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valence"
        }
      },
      "required": [
        "provenance"
      ],
      "title": "HeardTone",
      "type": "object"
    },
    "ReflectionDay": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "declined": {
          "default": false,
          "title": "Declined",
          "type": "boolean"
        },
        "energy": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy"
        },
        "heard": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeardTone"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "as reported by the model in the conversation"
        },
        "part": {
          "enum": [
            "morning",
            "afternoon",
            "evening"
          ],
          "title": "Part",
          "type": "string"
        },
        "themes": {
          "items": {
            "type": "string"
          },
          "title": "Themes",
          "type": "array"
        },
        "tone": {
          "description": "from their words (rules or Gemma)",
          "items": {
            "enum": [
              "flat",
              "tense",
              "tearful",
              "irritable",
              "warm",
              "playful",
              "calm"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Tone",
          "type": "array"
        },
        "valence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "neutral",
                "bright"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valence"
        }
      },
      "required": [
        "date",
        "part"
      ],
      "title": "ReflectionDay",
      "type": "object"
    },
    "SourceCount": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "e.g. 'walks', 'minutes outside', 'drum sessions'",
          "title": "Label",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "SourceCount",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Reflections with Kaiku at summary level: how many sounded low / neutral / bright and what they were about.\nPresent only when the person shares with the care team. Never their words.",
  "properties": {
    "bright": {
      "minimum": 0,
      "title": "Bright",
      "type": "integer"
    },
    "days": {
      "description": "the last 14 days, oldest first",
      "items": {
        "$ref": "#/$defs/ReflectionDay"
      },
      "title": "Days",
      "type": "array"
    },
    "declined": {
      "description": "the person asked to stop or did not want to talk",
      "minimum": 0,
      "title": "Declined",
      "type": "integer"
    },
    "low": {
      "minimum": 0,
      "title": "Low",
      "type": "integer"
    },
    "neutral": {
      "minimum": 0,
      "title": "Neutral",
      "type": "integer"
    },
    "reflections": {
      "description": "reflections with a summary in the last 7 days",
      "minimum": 0,
      "title": "Reflections",
      "type": "integer"
    },
    "shared": {
      "title": "Shared",
      "type": "boolean"
    },
    "summary": {
      "description": "the fortnight in one or two sentences; counts are 7 days",
      "maxLength": 400,
      "title": "Summary",
      "type": "string"
    },
    "themes": {
      "description": "theme -> reflections it came up in",
      "items": {
        "$ref": "#/$defs/SourceCount"
      },
      "title": "Themes",
      "type": "array"
    },
    "tone_summary": {
      "anyOf": [
        {
          "maxLength": 400,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "how they sounded, by provenance: tone of their words, and tone as reported by the model in the conversation",
      "title": "Tone Summary"
    }
  },
  "required": [
    "shared",
    "reflections",
    "low",
    "neutral",
    "bright",
    "declined",
    "summary"
  ],
  "title": "ReflectionOverview",
  "type": "object"
}
