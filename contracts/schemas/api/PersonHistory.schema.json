{
  "$defs": {
    "HistoryDay": {
      "additionalProperties": false,
      "description": "One local day of one measure.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "sessions": {
          "description": "readings that day that the value is made from",
          "minimum": 1,
          "title": "Sessions",
          "type": "integer"
        },
        "sim": {
          "default": false,
          "description": "some of that day's readings are simulated",
          "title": "Sim",
          "type": "boolean"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "date",
        "value",
        "sessions"
      ],
      "title": "HistoryDay",
      "type": "object"
    },
    "HistoryGroup": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "robot",
            "games",
            "walks",
            "checkins",
            "sleep_body",
            "mac",
            "camera"
          ],
          "title": "Key",
          "type": "string"
        },
        "measures": {
          "items": {
            "$ref": "#/$defs/HistoryMeasure"
          },
          "title": "Measures",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "key",
        "title",
        "measures"
      ],
      "title": "HistoryGroup",
      "type": "object"
    },
    "HistoryMeasure": {
      "additionalProperties": false,
      "description": "One measure over the window: its days, the person's usual range when there is one, and its latest sessions.",
      "properties": {
        "days": {
          "description": "days with a value, oldest first; a day without data is absent",
          "items": {
            "$ref": "#/$defs/HistoryDay"
          },
          "title": "Days",
          "type": "array"
        },
        "decimals": {
          "default": 0,
          "description": "how many decimals the value is worth showing with",
          "maximum": 2,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "devices": {
          "description": "where its readings came from in this window, most first (head, sensors and hub are all the robot)",
          "items": {
            "enum": [
              "robot",
              "phone",
              "mac",
              "glasses",
              "watch",
              "web"
            ],
            "type": "string"
          },
          "title": "Devices",
          "type": "array"
        },
        "format": {
          "default": "number",
          "description": "clock: minutes after local midnight; percent: a share 0..1 shown as a percentage; duration: minutes shown as hours and minutes. `usual` is in the same format",
          "enum": [
            "number",
            "clock",
            "percent",
            "duration"
          ],
          "title": "Format",
          "type": "string"
        },
        "key": {
          "description": "stable key; for a measure the practitioner side also computes, the same name",
          "title": "Key",
          "type": "string"
        },
        "per_day": {
          "description": "how one day's value is made from that day's sessions",
          "enum": [
            "average",
            "total",
            "highest",
            "lowest",
            "latest",
            "first",
            "count"
          ],
          "title": "Per Day",
          "type": "string"
        },
        "sessions": {
          "description": "newest first",
          "items": {
            "$ref": "#/$defs/HistorySession"
          },
          "maxItems": 30,
          "title": "Sessions",
          "type": "array"
        },
        "sim": {
          "default": false,
          "title": "Sim",
          "type": "boolean"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "usual": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryUsual"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "key",
        "title",
        "per_day",
        "devices",
        "days"
      ],
      "title": "HistoryMeasure",
      "type": "object"
    },
    "HistorySession": {
      "additionalProperties": false,
      "description": "One recorded session (a drum session, one game, a breathing round, a walk, one dial answer, one morning's\nwatch summary) with its own numbers.",
      "properties": {
        "device": {
          "enum": [
            "robot",
            "phone",
            "mac",
            "glasses",
            "watch",
            "web"
          ],
          "title": "Device",
          "type": "string"
        },
        "id": {
          "description": "the observation's id",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "which kind of session, where one measure lists several (a ritual step: Breathing, Drumming)",
          "title": "Label"
        },
        "sim": {
          "default": false,
          "title": "Sim",
          "type": "boolean"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/HistoryValue"
          },
          "maxItems": 16,
          "title": "Values",
          "type": "array"
        },
        "warmup": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "games: a practice session, left out of the day's value",
          "title": "Warmup"
        }
      },
      "required": [
        "id",
        "ts",
        "device"
      ],
      "title": "HistorySession",
      "type": "object"
    },
    "HistoryUsual": {
      "additionalProperties": false,
      "description": "The person's own usual range for a measure, from their own earlier days. A range and nothing else.",
      "properties": {
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "HistoryUsual",
      "type": "object"
    },
    "HistoryValue": {
      "additionalProperties": false,
      "description": "One number of one session, ready to show.",
      "properties": {
        "format": {
          "default": "number",
          "enum": [
            "number",
            "clock",
            "percent",
            "duration"
          ],
          "title": "Format",
          "type": "string"
        },
        "key": {
          "description": "payload field, e.g. tempo_bpm",
          "title": "Key",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "key",
        "title",
        "value"
      ],
      "title": "HistoryValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "GET /v1/me/history?home_id=&days= — the person's own numbers, as a health app shows them: every measure\nthe home has produced, from every device, by local day, with the latest sessions one tap away. Groups come in\na fixed order (robot, games, walks, checkins, sleep_body, mac, camera); a group or measure with no data in the\nwindow is left out. `camera` holds the face signs counted with \"Camera during activities\" on (D52): her own\nnumbers like every other group, never a word for what they might mean. It is the one person-facing place where numbers are shown (D48), and it carries numbers only:\nnever a state, a verdict, a score against the usual, a flag, a weight, a direction word, anything from the\npractitioner's review, a safety flag or a questionnaire answer.",
  "properties": {
    "days": {
      "description": "the window asked for",
      "maximum": 90,
      "minimum": 1,
      "title": "Days",
      "type": "integer"
    },
    "first_day": {
      "format": "date",
      "title": "First Day",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/HistoryGroup"
      },
      "title": "Groups",
      "type": "array"
    },
    "home_id": {
      "title": "Home Id",
      "type": "string"
    },
    "last_day": {
      "format": "date",
      "title": "Last Day",
      "type": "string"
    },
    "sim": {
      "default": false,
      "description": "the window contains simulated readings",
      "title": "Sim",
      "type": "boolean"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    }
  },
  "required": [
    "home_id",
    "days",
    "first_day",
    "last_day",
    "timezone",
    "groups",
    "generated_at"
  ],
  "title": "PersonHistory",
  "type": "object"
}
