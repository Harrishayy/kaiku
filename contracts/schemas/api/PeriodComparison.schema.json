{
  "$defs": {
    "GroupComparison": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "days_previous_week": {
          "maximum": 7,
          "minimum": 0,
          "title": "Days Previous Week",
          "type": "integer"
        },
        "days_this_week": {
          "maximum": 7,
          "minimum": 0,
          "title": "Days This Week",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "meaning": {
          "maxLength": 300,
          "title": "Meaning",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricComparison"
          },
          "title": "Metrics",
          "type": "array"
        },
        "source": {
          "enum": [
            "robot",
            "glasses",
            "laptop",
            "wearable"
          ],
          "title": "Source",
          "type": "string"
        },
        "trend": {
          "description": "this week vs the week before across this group's measures",
          "enum": [
            "better",
            "worse",
            "similar",
            "unknown"
          ],
          "title": "Trend",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "better",
            "as_usual",
            "worse",
            "insufficient"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "source",
        "label",
        "verdict",
        "confidence",
        "days_this_week",
        "days_previous_week",
        "trend",
        "meaning"
      ],
      "title": "GroupComparison",
      "type": "object"
    },
    "MetricComparison": {
      "additionalProperties": false,
      "description": "One measure: this week vs the week before vs the person's own usual. Medians of recorded days.",
      "properties": {
        "baseline_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "recorded days behind the usual",
          "title": "Baseline Days"
        },
        "days_previous_week": {
          "maximum": 7,
          "minimum": 0,
          "title": "Days Previous Week",
          "type": "integer"
        },
        "days_this_week": {
          "maximum": 7,
          "minimum": 0,
          "title": "Days This Week",
          "type": "integer"
        },
        "early_baseline": {
          "default": false,
          "description": "the usual is a provisional baseline of a young record",
          "title": "Early Baseline",
          "type": "boolean"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "meaning": {
          "maxLength": 300,
          "title": "Meaning",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "previous_week": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Week"
        },
        "previous_week_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Week Text"
        },
        "source": {
          "enum": [
            "robot",
            "glasses",
            "laptop",
            "wearable"
          ],
          "title": "Source",
          "type": "string"
        },
        "sustained": {
          "description": "the rule engine's reading over recent days (criteria thresholds), not a one-week difference",
          "enum": [
            "change_from_usual",
            "better_than_usual",
            "as_usual",
            "not_enough_data"
          ],
          "title": "Sustained",
          "type": "string"
        },
        "this_week": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "This Week"
        },
        "this_week_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "This Week Text"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "usual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "personal baseline median for the latest scored day",
          "title": "Usual"
        },
        "usual_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usual Text"
        },
        "vs_previous": {
          "enum": [
            "better",
            "worse",
            "similar",
            "unknown"
          ],
          "title": "Vs Previous",
          "type": "string"
        },
        "vs_usual": {
          "enum": [
            "better",
            "worse",
            "similar",
            "unknown"
          ],
          "title": "Vs Usual",
          "type": "string"
        },
        "worse_when": {
          "enum": [
            "up",
            "down"
          ],
          "title": "Worse When",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "label",
        "source",
        "worse_when",
        "days_this_week",
        "days_previous_week",
        "vs_previous",
        "vs_usual",
        "sustained",
        "meaning"
      ],
      "title": "MetricComparison",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "back_in_range": {
      "description": "metric names back within usual after a spell",
      "items": {
        "type": "string"
      },
      "title": "Back In Range",
      "type": "array"
    },
    "changed": {
      "description": "metric names worse than the week before",
      "items": {
        "type": "string"
      },
      "title": "Changed",
      "type": "array"
    },
    "day_of_record": {
      "default": 0,
      "minimum": 0,
      "title": "Day Of Record",
      "type": "integer"
    },
    "early_baseline": {
      "default": false,
      "description": "at least one usual here is a provisional baseline",
      "title": "Early Baseline",
      "type": "boolean"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/GroupComparison"
      },
      "title": "Groups",
      "type": "array"
    },
    "improved": {
      "description": "metric names better than the week before",
      "items": {
        "type": "string"
      },
      "title": "Improved",
      "type": "array"
    },
    "previous_week_end": {
      "format": "date",
      "title": "Previous Week End",
      "type": "string"
    },
    "previous_week_start": {
      "format": "date",
      "title": "Previous Week Start",
      "type": "string"
    },
    "since_low": {
      "default": "",
      "description": "against the spell's low point, e.g. '12 of 18 measures back within usual since the low on 8 Nov'; empty when nothing moved",
      "maxLength": 240,
      "title": "Since Low",
      "type": "string"
    },
    "still_away": {
      "description": "metric names still away from usual",
      "items": {
        "type": "string"
      },
      "title": "Still Away",
      "type": "array"
    },
    "summary": {
      "maxLength": 400,
      "title": "Summary",
      "type": "string"
    },
    "this_week_end": {
      "format": "date",
      "title": "This Week End",
      "type": "string"
    },
    "this_week_start": {
      "format": "date",
      "title": "This Week Start",
      "type": "string"
    }
  },
  "required": [
    "this_week_start",
    "this_week_end",
    "previous_week_start",
    "previous_week_end",
    "summary"
  ],
  "title": "PeriodComparison",
  "type": "object"
}
