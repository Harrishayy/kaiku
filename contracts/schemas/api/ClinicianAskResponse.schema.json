{
  "$defs": {
    "RecordCitation": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "simulated": {
          "default": false,
          "description": "rests on simulated observations",
          "title": "Simulated",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "RecordCitation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "maxLength": 2400,
      "title": "Answer",
      "type": "string"
    },
    "by": {
      "enum": [
        "gemma",
        "template"
      ],
      "title": "By",
      "type": "string"
    },
    "cached": {
      "default": false,
      "title": "Cached",
      "type": "boolean"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/RecordCitation"
      },
      "title": "Citations",
      "type": "array"
    },
    "computed_at": {
      "format": "date-time",
      "title": "Computed At",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "patient_id": {
      "title": "Patient Id",
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "answer",
    "by",
    "computed_at"
  ],
  "title": "ClinicianAskResponse",
  "type": "object"
}
