{
  "$defs": {
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "enum": [
            "body",
            "behaviour",
            "self_report",
            "voice",
            "safety"
          ],
          "title": "Group",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "since": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Since"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "z": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Z"
        }
      },
      "required": [
        "metric",
        "group",
        "summary"
      ],
      "title": "EvidenceItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Gemma (or template) clinician brief. Never diagnostic language.",
  "properties": {
    "caveats": {
      "maxLength": 600,
      "title": "Caveats",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "generated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated At"
    },
    "generated_by": {
      "default": "template",
      "title": "Generated By",
      "type": "string"
    },
    "headline": {
      "maxLength": 200,
      "title": "Headline",
      "type": "string"
    },
    "status": {
      "enum": [
        "green",
        "amber",
        "red"
      ],
      "title": "Status",
      "type": "string"
    },
    "suggested_actions": {
      "items": {
        "enum": [
          "book_booster",
          "refer_icbt",
          "send_message",
          "check_in_call",
          "none"
        ],
        "type": "string"
      },
      "title": "Suggested Actions",
      "type": "array"
    }
  },
  "required": [
    "status",
    "headline",
    "evidence",
    "suggested_actions",
    "caveats"
  ],
  "title": "Brief",
  "type": "object"
}
