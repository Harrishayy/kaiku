{
  "$defs": {
    "GroupCoverage": {
      "additionalProperties": false,
      "properties": {
        "days_last_14": {
          "maximum": 14,
          "minimum": 0,
          "title": "Days Last 14",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "last_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last At"
        },
        "source": {
          "enum": [
            "robot",
            "glasses",
            "laptop",
            "wearable"
          ],
          "title": "Source",
          "type": "string"
        },
        "sufficient": {
          "description": "enough recent usable data for this group to give a verdict",
          "title": "Sufficient",
          "type": "boolean"
        },
        "types": {
          "items": {
            "$ref": "#/$defs/ObsTypeCoverage"
          },
          "title": "Types",
          "type": "array"
        }
      },
      "required": [
        "source",
        "label",
        "sufficient",
        "days_last_14"
      ],
      "title": "GroupCoverage",
      "type": "object"
    },
    "ObsTypeCoverage": {
      "additionalProperties": false,
      "properties": {
        "captured_by": {
          "description": "envelope sources that sent it (hub, phone, …)",
          "items": {
            "type": "string"
          },
          "title": "Captured By",
          "type": "array"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "days": {
          "minimum": 0,
          "title": "Days",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "last_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last At"
        },
        "simulated": {
          "default": 0,
          "description": "how many of these observations carry sim=true",
          "minimum": 0,
          "title": "Simulated",
          "type": "integer"
        },
        "type": {
          "description": "obs.* type",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "label",
        "count",
        "days"
      ],
      "title": "ObsTypeCoverage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_ready": {
      "description": "at least one measure has a personal baseline",
      "title": "Baseline Ready",
      "type": "boolean"
    },
    "day_of_record": {
      "default": 0,
      "description": "calendar days since the first observation",
      "minimum": 0,
      "title": "Day Of Record",
      "type": "integer"
    },
    "early_baseline": {
      "default": false,
      "description": "baselines in use are provisional (young record)",
      "title": "Early Baseline",
      "type": "boolean"
    },
    "first_day": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Day"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/GroupCoverage"
      },
      "title": "Groups",
      "type": "array"
    },
    "last_day": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Day"
    },
    "observations": {
      "minimum": 0,
      "title": "Observations",
      "type": "integer"
    },
    "other": {
      "description": "activity responses, ritual steps, flags",
      "items": {
        "$ref": "#/$defs/ObsTypeCoverage"
      },
      "title": "Other",
      "type": "array"
    },
    "recorded_days": {
      "minimum": 0,
      "title": "Recorded Days",
      "type": "integer"
    },
    "simulated": {
      "description": "every observation in this record carries sim=true",
      "title": "Simulated",
      "type": "boolean"
    },
    "span_days": {
      "minimum": 0,
      "title": "Span Days",
      "type": "integer"
    },
    "summary": {
      "maxLength": 300,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "span_days",
    "recorded_days",
    "observations",
    "baseline_ready",
    "simulated",
    "summary"
  ],
  "title": "DataCoverage",
  "type": "object"
}
