{
  "$defs": {
    "HeardTone": {
      "additionalProperties": false,
      "description": "How a conversation sounded to the model that was in it, reported through the `feel` tool. An observation\nby a model, never a measurement and never a state. `model_heard`: the native-audio voice model heard the\nperson speak. `model_read`: it went by their typed or transcribed words only.",
      "properties": {
        "energy": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy"
        },
        "moments": {
          "default": 1,
          "description": "how many times a feeling was noticed in that conversation",
          "minimum": 1,
          "title": "Moments",
          "type": "integer"
        },
        "provenance": {
          "enum": [
            "model_heard",
            "model_read"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "tone": {
          "items": {
            "enum": [
              "flat",
              "tense",
              "tearful",
              "irritable",
              "warm",
              "playful",
              "calm"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Tone",
          "type": "array"
        },
        "valence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "neutral",
                "bright"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valence"
        }
      },
      "required": [
        "provenance"
      ],
      "title": "HeardTone",
      "type": "object"
    },
    "LastReflection": {
      "additionalProperties": false,
      "description": "How the latest talk with Kaiku went: a level and themes, never the words.",
      "properties": {
        "declined": {
          "default": false,
          "description": "they did not want to talk or asked to stop",
          "title": "Declined",
          "type": "boolean"
        },
        "energy": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy"
        },
        "heard": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeardTone"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "themes": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Themes",
          "type": "array"
        },
        "tone": {
          "description": "from their words (rules or Gemma)",
          "items": {
            "enum": [
              "flat",
              "tense",
              "tearful",
              "irritable",
              "warm",
              "playful",
              "calm"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Tone",
          "type": "array"
        },
        "valence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "neutral",
                "bright"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valence"
        },
        "when": {
          "description": "e.g. \"yesterday evening\", \"this morning\"",
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "when"
      ],
      "title": "LastReflection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agreed": {
      "description": "activities they said yes to today on any device and whether each is done (D50); each is carried once per state, so Kaiku is glad or asks gently once",
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "title": "Agreed",
      "type": "array"
    },
    "care_info": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Care Info"
    },
    "chat_depth": {
      "anyOf": [
        {
          "enum": [
            "brief",
            "stay"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "check-in sessions: how the chat should open",
      "title": "Chat Depth"
    },
    "done_today": {
      "description": "on any surface",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Done Today",
      "type": "array"
    },
    "dont_remember": {
      "default": false,
      "title": "Dont Remember",
      "type": "boolean"
    },
    "first_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "only if the person told Kaiku their name",
      "title": "First Name"
    },
    "focus": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "today's focus, chosen by the daily reflection from fixed options",
      "title": "Focus"
    },
    "intent": {
      "default": "talk",
      "enum": [
        "ritual",
        "checkin",
        "walk",
        "breathe",
        "talk",
        "break"
      ],
      "title": "Intent",
      "type": "string"
    },
    "language": {
      "default": "en",
      "enum": [
        "en",
        "fi",
        "sv"
      ],
      "title": "Language",
      "type": "string"
    },
    "last_reflection": {
      "anyOf": [
        {
          "$ref": "#/$defs/LastReflection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "memories": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "title": "Memories",
      "type": "array"
    },
    "open_items": {
      "description": "check-in sessions: dials not answered today; at most one is woven into the chat",
      "items": {
        "enum": [
          "mood",
          "energy",
          "sleep"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "title": "Open Items",
      "type": "array"
    },
    "open_thread": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "topic left open on any surface",
      "title": "Open Thread"
    },
    "others_present": {
      "default": false,
      "title": "Others Present",
      "type": "boolean"
    },
    "outdoor_likes": {
      "description": "walk sessions: outdoor things and places the person told Kaiku they like, in their words (notebook)",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Outdoor Likes",
      "type": "array"
    },
    "phq9_due": {
      "default": false,
      "title": "Phq9 Due",
      "type": "boolean"
    },
    "purpose": {
      "anyOf": [
        {
          "enum": [
            "talk",
            "check_in",
            "walk",
            "ritual"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "set when the device said why it opened the session",
      "title": "Purpose"
    },
    "quieter_in": {
      "description": "today's tasks in which the face signs counted with their opt-in were clearly below their own usual (D52, rule in mind/face_cue.py). An enum and nothing else: the instruction turns it into a cue to go gently and never to mention their face or a camera; no number, no state and no word about how they looked ever crosses",
      "items": {
        "enum": [
          "games",
          "check_in"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "title": "Quieter In",
      "type": "array"
    },
    "recent_reflection": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "how the latest reflection with Kaiku went, as a level and themes only (never the words), so Kaiku can be gentle about it",
      "title": "Recent Reflection"
    },
    "routines": {
      "description": "e.g. \"usually walks on Tuesdays\"",
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "title": "Routines",
      "type": "array"
    },
    "source_context": {
      "description": "prepared source-labelled activity facts; no clinical metrics or raw content",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Source Context",
      "type": "array"
    },
    "suggestion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "today's bandit suggestion, phrased",
      "title": "Suggestion"
    },
    "time_of_day": {
      "enum": [
        "morning",
        "afternoon",
        "evening",
        "night"
      ],
      "title": "Time Of Day",
      "type": "string"
    },
    "today_facts": {
      "description": "plain facts the person recorded themselves today, in everyday words (\"a short night\"); never a number or a judgement",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Today Facts",
      "type": "array"
    },
    "tone": {
      "default": "steady",
      "enum": [
        "steady",
        "gentle",
        "extra-gentle"
      ],
      "title": "Tone",
      "type": "string"
    },
    "walk_style": {
      "anyOf": [
        {
          "enum": [
            "quiet",
            "playful",
            "chatty"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "walk sessions: how Kaiku walks with them",
      "title": "Walk Style"
    },
    "weather_word": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weather Word"
    }
  },
  "required": [
    "time_of_day"
  ],
  "title": "ContextCard",
  "type": "object"
}
