{
  "$defs": {
    "LastReflection": {
      "additionalProperties": false,
      "description": "How the latest talk with Kaiku went: a level and themes, never the words.",
      "properties": {
        "declined": {
          "default": false,
          "description": "they did not want to talk or asked to stop",
          "title": "Declined",
          "type": "boolean"
        },
        "themes": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Themes",
          "type": "array"
        },
        "valence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "neutral",
                "bright"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valence"
        },
        "when": {
          "description": "e.g. \"yesterday evening\", \"this morning\"",
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "when"
      ],
      "title": "LastReflection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "care_info": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Care Info"
    },
    "done_today": {
      "description": "on any surface",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Done Today",
      "type": "array"
    },
    "dont_remember": {
      "default": false,
      "title": "Dont Remember",
      "type": "boolean"
    },
    "first_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "only if the person told Kaiku their name",
      "title": "First Name"
    },
    "focus": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "today's focus, chosen by the daily reflection from fixed options",
      "title": "Focus"
    },
    "intent": {
      "default": "talk",
      "enum": [
        "ritual",
        "checkin",
        "walk",
        "breathe",
        "talk",
        "break"
      ],
      "title": "Intent",
      "type": "string"
    },
    "language": {
      "default": "en",
      "enum": [
        "en",
        "fi",
        "sv"
      ],
      "title": "Language",
      "type": "string"
    },
    "last_reflection": {
      "anyOf": [
        {
          "$ref": "#/$defs/LastReflection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "memories": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "title": "Memories",
      "type": "array"
    },
    "open_thread": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "topic left open on any surface",
      "title": "Open Thread"
    },
    "others_present": {
      "default": false,
      "title": "Others Present",
      "type": "boolean"
    },
    "phq9_due": {
      "default": false,
      "title": "Phq9 Due",
      "type": "boolean"
    },
    "recent_reflection": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "how the latest reflection with Kaiku went, as a level and themes only (never the words), so Kaiku can be gentle about it",
      "title": "Recent Reflection"
    },
    "routines": {
      "description": "e.g. \"usually walks on Tuesdays\"",
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "title": "Routines",
      "type": "array"
    },
    "source_context": {
      "description": "prepared source-labelled activity facts; no clinical metrics or raw content",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Source Context",
      "type": "array"
    },
    "suggestion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "today's bandit suggestion, phrased",
      "title": "Suggestion"
    },
    "time_of_day": {
      "enum": [
        "morning",
        "afternoon",
        "evening",
        "night"
      ],
      "title": "Time Of Day",
      "type": "string"
    },
    "today_facts": {
      "description": "plain facts the person recorded themselves today, in everyday words (\"a short night\"); never a number or a judgement",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Today Facts",
      "type": "array"
    },
    "tone": {
      "default": "steady",
      "enum": [
        "steady",
        "gentle",
        "extra-gentle"
      ],
      "title": "Tone",
      "type": "string"
    },
    "weather_word": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weather Word"
    }
  },
  "required": [
    "time_of_day"
  ],
  "title": "ContextCard",
  "type": "object"
}
