{
  "additionalProperties": false,
  "description": "How a conversation sounded to the model that was in it, reported through the `feel` tool. An observation\nby a model, never a measurement and never a state. `model_heard`: the native-audio voice model heard the\nperson speak. `model_read`: it went by their typed or transcribed words only.",
  "properties": {
    "energy": {
      "anyOf": [
        {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Energy"
    },
    "moments": {
      "default": 1,
      "description": "how many times a feeling was noticed in that conversation",
      "minimum": 1,
      "title": "Moments",
      "type": "integer"
    },
    "provenance": {
      "enum": [
        "model_heard",
        "model_read"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "tone": {
      "items": {
        "enum": [
          "flat",
          "tense",
          "tearful",
          "irritable",
          "warm",
          "playful",
          "calm"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "title": "Tone",
      "type": "array"
    },
    "valence": {
      "anyOf": [
        {
          "enum": [
            "low",
            "neutral",
            "bright"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valence"
    }
  },
  "required": [
    "provenance"
  ],
  "title": "HeardTone",
  "type": "object"
}
