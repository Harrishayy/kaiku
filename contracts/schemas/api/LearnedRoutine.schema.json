{
  "$defs": {
    "HelpEffect": {
      "additionalProperties": false,
      "description": "What the learner has seen for one activity. A reported response, not proof that the activity caused it.",
      "properties": {
        "activity": {
          "title": "Activity",
          "type": "string"
        },
        "certainty": {
          "enum": [
            "early",
            "building",
            "consistent"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "high": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "low": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "90% interval of the learner's estimate",
          "title": "Low"
        },
        "mean_effect": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "mean reward 0..1 (0.5 = neutral)",
          "title": "Mean Effect"
        },
        "text": {
          "maxLength": 240,
          "title": "Text",
          "type": "string"
        },
        "tries": {
          "minimum": 0,
          "title": "Tries",
          "type": "integer"
        }
      },
      "required": [
        "activity",
        "label",
        "tries",
        "certainty",
        "text"
      ],
      "title": "HelpEffect",
      "type": "object"
    },
    "Routine": {
      "additionalProperties": false,
      "description": "A rhythm found BY CODE in the last weeks (obs, and conversations for the person or when shared).",
      "properties": {
        "activity": {
          "description": "ritual | walk | drum | breathe | checkin | laptop | play | sleep",
          "title": "Activity",
          "type": "string"
        },
        "basis": {
          "items": {
            "enum": [
              "obs",
              "episodes"
            ],
            "type": "string"
          },
          "title": "Basis",
          "type": "array"
        },
        "cadence": {
          "enum": [
            "daily",
            "most_days",
            "weekly"
          ],
          "title": "Cadence",
          "type": "string"
        },
        "day_part": {
          "anyOf": [
            {
              "enum": [
                "morning",
                "afternoon",
                "evening",
                "night"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day Part"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "status": {
          "enum": [
            "kept",
            "partly",
            "slipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "description": "worded for the audience",
          "maxLength": 200,
          "title": "Text",
          "type": "string"
        },
        "this_week": {
          "description": "days with it in the last 7 days",
          "maximum": 7,
          "minimum": 0,
          "title": "This Week",
          "type": "integer"
        },
        "usual_per_week": {
          "maximum": 7,
          "minimum": 0,
          "title": "Usual Per Week",
          "type": "number"
        },
        "usual_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "local HH:MM (median of the usual weeks)",
          "title": "Usual Time"
        },
        "weekday": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "for weekly routines, e.g. 'Tuesday'",
          "title": "Weekday"
        }
      },
      "required": [
        "activity",
        "label",
        "cadence",
        "usual_per_week",
        "this_week",
        "status",
        "text"
      ],
      "title": "Routine",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "caveat": {
      "default": "",
      "description": "how far the reported responses can be trusted",
      "maxLength": 300,
      "title": "Caveat",
      "type": "string"
    },
    "day_of_record": {
      "default": 0,
      "minimum": 0,
      "title": "Day Of Record",
      "type": "integer"
    },
    "early_record": {
      "default": false,
      "title": "Early Record",
      "type": "boolean"
    },
    "helps": {
      "items": {
        "$ref": "#/$defs/HelpEffect"
      },
      "title": "Helps",
      "type": "array"
    },
    "kept": {
      "minimum": 0,
      "title": "Kept",
      "type": "integer"
    },
    "partly": {
      "minimum": 0,
      "title": "Partly",
      "type": "integer"
    },
    "routines": {
      "items": {
        "$ref": "#/$defs/Routine"
      },
      "title": "Routines",
      "type": "array"
    },
    "slipped": {
      "minimum": 0,
      "title": "Slipped",
      "type": "integer"
    },
    "summary": {
      "maxLength": 300,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "kept",
    "partly",
    "slipped",
    "summary"
  ],
  "title": "LearnedRoutine",
  "type": "object"
}
