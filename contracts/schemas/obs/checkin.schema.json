{
  "$defs": {
    "Checkin": {
      "additionalProperties": false,
      "properties": {
        "item9_positive": {
          "title": "Item9 Positive",
          "type": "boolean"
        },
        "phq9_total": {
          "maximum": 27,
          "minimum": 0,
          "title": "Phq9 Total",
          "type": "integer"
        },
        "speech_task": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpeechFeatures"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "phq9_total",
        "item9_positive"
      ],
      "title": "Checkin",
      "type": "object"
    },
    "SpeechFeatures": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "pause_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pause Ratio",
          "type": "number"
        },
        "speech_rate_wpm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speech Rate Wpm"
        },
        "syllables_per_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Syllables Per S"
        }
      },
      "required": [
        "pause_ratio",
        "duration_s"
      ],
      "title": "SpeechFeatures",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "home_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Home Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/Checkin"
    },
    "quality": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality"
    },
    "sim": {
      "default": false,
      "title": "Sim",
      "type": "boolean"
    },
    "source": {
      "enum": [
        "head",
        "sensors",
        "hub",
        "friendlink",
        "glasses",
        "checkin",
        "cloud",
        "sim"
      ],
      "title": "Source",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "home_id",
    "source",
    "type",
    "payload"
  ],
  "title": "Envelope<obs.checkin>",
  "type": "object"
}
