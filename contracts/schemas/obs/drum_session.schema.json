{
  "$defs": {
    "DrumSession": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "force_mean": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None when the drum can't sense force (KY-031 knock switch)",
          "title": "Force Mean"
        },
        "pauses": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "gaps > 2 s inside the session",
          "title": "Pauses"
        },
        "regularity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Regularity",
          "type": "number"
        },
        "rejected_taps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "double-triggers dropped by the refractory window",
          "title": "Rejected Taps"
        },
        "taps": {
          "minimum": 0,
          "title": "Taps",
          "type": "integer"
        },
        "taps_per_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "energy proxy that needs no force sensor",
          "title": "Taps Per S"
        },
        "tempo_bpm": {
          "maximum": 400,
          "minimum": 0,
          "title": "Tempo Bpm",
          "type": "number"
        },
        "tempo_end_bpm": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tempo of the last third of the taps",
          "title": "Tempo End Bpm"
        },
        "tempo_start_bpm": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tempo of the first third of the taps",
          "title": "Tempo Start Bpm"
        }
      },
      "required": [
        "tempo_bpm",
        "duration_s",
        "regularity",
        "taps"
      ],
      "title": "DrumSession",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "home_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Home Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/DrumSession"
    },
    "quality": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality"
    },
    "sim": {
      "default": false,
      "title": "Sim",
      "type": "boolean"
    },
    "source": {
      "enum": [
        "head",
        "sensors",
        "hub",
        "friendlink",
        "glasses",
        "laptop",
        "phone",
        "cloud",
        "sim"
      ],
      "title": "Source",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "home_id",
    "source",
    "type",
    "payload"
  ],
  "title": "Envelope<obs.drum_session>",
  "type": "object"
}
