{
  "$defs": {
    "WearableDaily": {
      "additionalProperties": false,
      "description": "Daily summary from Apple Health (HealthKit) on the iPhone: Apple Watch or any watch that writes to Apple Health.\nPosted once per morning; `date` = that local morning: sleep = the night that ended this morning, steps /\nexercise / resting HR / HRV = the previous 24 h. Only these aggregates leave the phone (no raw samples).\nOptional source: people without a watch simply never send it.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "device": {
          "enum": [
            "apple_watch",
            "other_watch",
            "phone_only"
          ],
          "title": "Device",
          "type": "string"
        },
        "exercise_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Min"
        },
        "hrv_sdnn_ms": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hrv Sdnn Ms"
        },
        "resting_hr_bpm": {
          "anyOf": [
            {
              "exclusiveMaximum": 250,
              "exclusiveMinimum": 20,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resting Hr Bpm"
        },
        "sleep_midpoint_min": {
          "anyOf": [
            {
              "maximum": 720,
              "minimum": -720,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "midpoint of last night's sleep, minutes from local midnight (-30 = 23:30, 210 = 03:30)",
          "title": "Sleep Midpoint Min"
        },
        "sleep_min": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "minutes asleep last night",
          "title": "Sleep Min"
        },
        "sleep_regularity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1 = same sleep times every night",
          "title": "Sleep Regularity"
        },
        "steps": {
          "anyOf": [
            {
              "maximum": 200000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps"
        }
      },
      "required": [
        "date",
        "device"
      ],
      "title": "WearableDaily",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "home_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Home Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/WearableDaily"
    },
    "quality": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality"
    },
    "sim": {
      "default": false,
      "title": "Sim",
      "type": "boolean"
    },
    "source": {
      "enum": [
        "head",
        "sensors",
        "hub",
        "friendlink",
        "glasses",
        "laptop",
        "phone",
        "cloud",
        "sim"
      ],
      "title": "Source",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "home_id",
    "source",
    "type",
    "payload"
  ],
  "title": "Envelope<obs.wearable_daily>",
  "type": "object"
}
