{
  "$defs": {
    "SelfReport": {
      "additionalProperties": false,
      "description": "One dial answer (turn the ear). The ritual asks mood, energy, last night's sleep.",
      "properties": {
        "context": {
          "default": "ritual",
          "enum": [
            "ritual",
            "adhoc",
            "post_activity"
          ],
          "title": "Context",
          "type": "string"
        },
        "item": {
          "enum": [
            "mood",
            "energy",
            "sleep"
          ],
          "title": "Item",
          "type": "string"
        },
        "value": {
          "maximum": 5,
          "minimum": 1,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "item",
        "value"
      ],
      "title": "SelfReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "home_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Home Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/SelfReport"
    },
    "quality": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality"
    },
    "sim": {
      "default": false,
      "title": "Sim",
      "type": "boolean"
    },
    "source": {
      "enum": [
        "head",
        "sensors",
        "hub",
        "friendlink",
        "glasses",
        "laptop",
        "cloud",
        "sim"
      ],
      "title": "Source",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "home_id",
    "source",
    "type",
    "payload"
  ],
  "title": "Envelope<obs.self_report>",
  "type": "object"
}
