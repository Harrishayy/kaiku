{
  "$defs": {
    "LaptopSession": {
      "additionalProperties": false,
      "description": "2-minute laptop session. All features computed in the browser; nothing recorded.\nAny feature may be None if that part was skipped or unsupported (e.g. no webcam).",
      "properties": {
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "expressivity_index": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expressivity Index"
        },
        "lapses": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "responses > 500 ms or misses",
          "title": "Lapses"
        },
        "pause_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pause Ratio"
        },
        "pitch_variability": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "semitones SD",
          "title": "Pitch Variability"
        },
        "reaction_ms_iqr": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reaction Ms Iqr"
        },
        "reaction_ms_median": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reaction Ms Median"
        },
        "speech_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "syllables per second",
          "title": "Speech Rate"
        }
      },
      "required": [
        "duration_s"
      ],
      "title": "LaptopSession",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "home_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Home Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/LaptopSession"
    },
    "quality": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality"
    },
    "sim": {
      "default": false,
      "title": "Sim",
      "type": "boolean"
    },
    "source": {
      "enum": [
        "head",
        "sensors",
        "hub",
        "friendlink",
        "glasses",
        "laptop",
        "phone",
        "cloud",
        "sim"
      ],
      "title": "Source",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "home_id",
    "source",
    "type",
    "payload"
  ],
  "title": "Envelope<obs.laptop_session>",
  "type": "object"
}
