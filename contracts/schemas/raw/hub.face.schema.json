{
  "$defs": {
    "RawFace": {
      "additionalProperties": false,
      "description": "Face position only. Images are never published, stored or transmitted.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "size": {
          "maximum": 1,
          "minimum": 0,
          "title": "Size",
          "type": "number"
        },
        "x_norm": {
          "maximum": 1,
          "minimum": -1,
          "title": "X Norm",
          "type": "number"
        },
        "y_norm": {
          "maximum": 1,
          "minimum": -1,
          "title": "Y Norm",
          "type": "number"
        }
      },
      "required": [
        "x_norm",
        "y_norm",
        "size",
        "confidence"
      ],
      "title": "RawFace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "home_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Home Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/RawFace"
    },
    "quality": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality"
    },
    "sim": {
      "default": false,
      "title": "Sim",
      "type": "boolean"
    },
    "source": {
      "enum": [
        "head",
        "sensors",
        "hub",
        "friendlink",
        "glasses",
        "laptop",
        "cloud",
        "sim"
      ],
      "title": "Source",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "home_id",
    "source",
    "type",
    "payload"
  ],
  "title": "Envelope<raw.hub.face>",
  "type": "object"
}
