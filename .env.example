# Copy to .env and fill in. NAMES ONLY in git — never commit values.
# One key for every Gemini call: Live (robot + ephemeral tokens for apps), TTS voice lines, Lyria, flagship +
# fast text (cloud mind, explanations), eval judge, hosted Gemma. Get it at https://aistudio.google.com/apikey
GEMINI_API_KEY=
KAIKU_HOME_ID=demo-aino
KAIKU_HOME_TOKEN=
KAIKU_ADMIN_TOKEN=
KAIKU_CLOUD_URL=http://localhost:8000
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
HF_TOKEN=                # only for local Gemma downloads; Modal uses its own `huggingface` secret
KAIKU_HEAD=sim          # atech | sim
KAIKU_SENSORS=sim       # unoq | sim
KAIKU_VOICE=text        # gemini (Live, needs the key) | text | off
KAIKU_MUSIC=off         # lyria | local | off
KAIKU_LLM=auto          # auto (Gemma hosted -> Gemini fast -> template) | gemma_modal | gemma_hosted | gemini | template
KAIKU_DEMO_MODE=1
KAIKU_LOG_LEVEL=INFO
