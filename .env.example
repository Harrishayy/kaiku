KAIKU_SENSORS=sim       # unoq | sim
KAIKU_VOICE=text        # gemini | text | off
KAIKU_MUSIC=off         # lyria | local | off
KAIKU_LLM=template      # gemma_modal | gemma_hosted | template
KAIKU_DEMO_MODE=1
KAIKU_LOG_LEVEL=INFO
