# Kaiku — every entry point lives here. `make help` lists them.
SHELL := /bin/bash
.DEFAULT_GOAL := help
UV ?= uv
RUN := $(UV) run --quiet
MOSQUITTO ?= $(shell command -v mosquitto 2>/dev/null || ls /opt/homebrew/sbin/mosquitto /usr/local/sbin/mosquitto /usr/sbin/mosquitto 2>/dev/null | head -1)
TOPIC ?= kaiku/v1/\#
NODES ?= head,sensors,glasses,laptop,phone
ROLE ?= all

.PHONY: help
help: ## list targets
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN{FS=":.*?## "}{printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}'

# ---------------------------------------------------------------- setup
.PHONY: bootstrap setup env
bootstrap: ## install toolchain for a role: make bootstrap ROLE=all|hub|cloud|web|firmware|glasses-web|glasses-dat
	@./scripts/bootstrap.sh $(ROLE)
setup: env ## uv sync + web deps (idempotent)
	$(UV) sync
	@if [ -f apps/web/package.json ]; then cd apps/web && pnpm install --silent; fi
env: ## create .env from .env.example if missing
	@[ -f .env ] || (cp .env.example .env && echo "created .env — fill in secrets")

# ---------------------------------------------------------------- contracts
.PHONY: contracts test-contracts agents criteria tune calibrate design
design: ## regenerate design/generated (tokens.css, Tokens.swift) + design/mascot.svg from design/*.json
	$(RUN) python design/gen.py
criteria: ## validate config/criteria.toml and print the effective rule version + metrics per source
	$(RUN) python -c "from kaiku_contracts.criteria import load_criteria as L; c=L(); print(c.rule_version); [print(f'  {s:8} ', ', '.join(m.name+('' if m.weight==1 else f'x{m.weight:g}') for m in c.metrics_for(s)), '| rules:', ', '.join(r.name for r in c.rules_for(s)) or '-') for s in c.active_sources()]"
tune: ## simulate consensus quality for a criteria file: make tune [CRITERIA=path] [COMPARE=path] [N=40]
	$(RUN) python -m kaiku_cloud.jobs.simulate --criteria $(or $(CRITERIA),config/criteria.toml) $(if $(COMPARE),--compare $(COMPARE)) --n $(or $(N),40)
calibrate: ## how well does the rule tell "not well" from "ok"? labelled synthetic courses: make calibrate [CRITERIA=path] [COMPARE=path] [N=40]
	$(RUN) python -m kaiku_cloud.analytics.calibration --criteria $(or $(CRITERIA),config/criteria.toml) $(if $(COMPARE),--compare $(COMPARE)) --n $(or $(N),40)
agents: ## regenerate the module index in AGENTS.md, then check the one-AGENTS.md-per-module rule
	$(RUN) python tools/agents_sync.py
contracts: ## regenerate JSON Schemas + TS types from the pydantic models
	$(RUN) python -m kaiku_contracts.export
	npx --yes json-schema-to-typescript@15.0.4 -i contracts/schemas/bundle.schema.json -o contracts/ts/models.ts \
	  --unreachableDefinitions --additionalProperties false \
	  --bannerComment "/* GENERATED by \`make contracts\` from contracts/python (pydantic). Do not edit. */"
test-contracts: ## contract round-trip tests + stale-schema check
	$(RUN) pytest contracts/tests

# ---------------------------------------------------------------- local system
.PHONY: broker sim hub tail record replay
broker: ## start mosquitto on :1883 (foreground)
	@if [ -z "$(MOSQUITTO)" ]; then echo "mosquitto not found: brew install mosquitto | apt install mosquitto"; exit 1; fi
	$(MOSQUITTO) -c config/mosquitto.conf
sim: ## run sim twins: make sim NODES=head,sensors,friendlink,glasses,laptop,phone [ARGS=--keyboard]
	$(RUN) python -m sim.run --nodes $(NODES) $(ARGS)
hub: ## run the hub (reads .env; KAIKU_VOICE=text for keyboard ritual)
	$(RUN) python -m kaiku_hub.main $(ARGS)
tail: ## pretty-print bus traffic: make tail TOPIC='kaiku/v1/+/obs/#'
	$(RUN) python tools/bus_tail.py '$(TOPIC)'
record: ## record bus traffic to logs/<ts>.jsonl: make record [TOPIC=...]
	$(RUN) python tools/record.py '$(TOPIC)'
replay: ## replay a recording: make replay FILE=logs/x.jsonl [SPEED=1]
	$(RUN) python tools/replay.py $(FILE) --speed $(or $(SPEED),1)

# ---------------------------------------------------------------- cloud & web
.PHONY: cloud-local cloud-dev cloud-deploy gemma-download gemma-deploy gemma-smoke seed web web-build voice-prerender
cloud-local: ## run the LAN demo API with Bonjour discovery (no robot or Modal needed)
	KAIKU_DEMO_MODE=1 $(RUN) python tools/cloud_local.py --reload $(ARGS)
cloud-dev: ## modal serve (hot-reload on Modal)
	cd cloud && $(RUN) modal serve app.py
cloud-deploy: web-build ## modal deploy (public URL)
	cd cloud && $(RUN) modal deploy app.py
gemma-download: ## once: Gemma weights -> Modal Volume (CPU only, no GPU time)
	cd cloud && $(RUN) modal run gemma_app.py::download
gemma-deploy: ## register the scale-to-zero Gemma app on Modal (no container starts)
	cd cloud && $(RUN) modal deploy gemma_app.py
gemma-smoke: ## ONE cold Gemma call (~2-4 min GPU), then it scales to zero
	cd cloud && $(RUN) modal run gemma_app.py::smoke
seed: ## seed the cloud with simulated patients (KAIKU_CLOUD_URL) [ARGS=--reset]
	$(RUN) python -m sim.seed_demo $(ARGS)
voice-prerender: ## render every config/voice_lines.toml line into the TTS cache (needs GEMINI_API_KEY) [ARGS=--lang en]
	$(RUN) python -m kaiku_cloud.voice $(ARGS)
web: ## Next.js dev server on :3000 (talks to the cloud API at NEXT_PUBLIC_KAIKU_API, default :8000)
	cd apps/web && NEXT_PUBLIC_KAIKU_API=$${NEXT_PUBLIC_KAIKU_API:-http://localhost:8000} pnpm dev
web-build: ## static-export the Next.js app to apps/web/out (served by the cloud)
	@if [ -f apps/web/package.json ]; then cd apps/web && pnpm install --silent && pnpm build; fi

# ---------------------------------------------------------------- quality
.PHONY: test lint fmt doctor demo demo-reset live-day check smoke eval-companion spend
spend: ## paid model spend so far vs the hard cap (config/kaiku.toml [budget])
	$(RUN) python -m kaiku_contracts.budget
smoke: ## end-to-end: throwaway cloud + seed + key endpoint checks (run before every merge)
	./scripts/smoke.sh
e2e-intelligence: ## REAL model calls (cents): session + Live token round trip (typed, spoken, barge-in) + TTS + ask_mind + graph [KAIKU_ENV_FILE=]
	$(RUN) python scripts/e2e_intelligence.py
test: ## all Python tests (+ web typecheck if installed)
	$(RUN) pytest
	@if [ -d apps/web/node_modules ]; then cd apps/web && pnpm -s typecheck; fi
lint: ## ruff
	$(RUN) ruff check .
fmt: ## ruff format + fix
	$(RUN) ruff check --fix . && $(RUN) ruff format .
doctor: ## environment + live system health report
	$(RUN) python tools/doctor.py
bench-list: ## list the electronics bench tests (one per part; tools/bench.py)
	$(RUN) python tools/bench.py --list
bench: ## test ONE part alone: make bench PART=firmware/unoq-sensors/bench/knock [FROM=serial:/dev/tty.x | - | mqtt | file.log]
	$(RUN) $(if $(findstring serial:,$(FROM)),--with pyserial,) python tools/bench.py $(PART) $(if $(FROM),--from '$(FROM)',)
unoq-app: ## copy kaiku_contracts + config into the UNO Q App Lab app (python/vendor, gitignored)
	rm -rf firmware/unoq-sensors/python/vendor && mkdir -p firmware/unoq-sensors/python/vendor/config
	cp -a contracts/python/kaiku_contracts firmware/unoq-sensors/python/vendor/
	cp config/kaiku.toml firmware/unoq-sensors/python/vendor/config/
	find firmware/unoq-sensors/python/vendor -name __pycache__ -prune -exec rm -rf {} +
	@echo "now open firmware/unoq-sensors in App Lab (python/ + sketch/) and Run"
.PHONY: atech-setup
ATECH_VENV := firmware/atech-head/.venv
atech-setup: ## Atech SDK venv + pinned ESP32 toolchain, all inside firmware/atech-head/.venv (then: source it, atech build)
	@test -x $(ATECH_VENV)/bin/python || $(UV) venv --python 3.12 $(ATECH_VENV)
	$(UV) pip install --python $(ATECH_VENV)/bin/python -r firmware/atech-head/requirements.txt
	@grep -q PLATFORMIO_CORE_DIR $(ATECH_VENV)/bin/activate || printf '\n# Kaiku: keep PlatformIO (ESP32 toolchain, ~3 GB) inside this venv\nexport PLATFORMIO_CORE_DIR="$$VIRTUAL_ENV/platformio"\n' >> $(ATECH_VENV)/bin/activate
	@# Atech's drivers target Arduino core 2.0 (espressif32 6.x); the SDK leaves the platform unpinned and 8.x breaks dc_motor
	PLATFORMIO_CORE_DIR=$(CURDIR)/$(ATECH_VENV)/platformio $(ATECH_VENV)/bin/pio pkg install -g -p "platformio/espressif32@6.9.0"
	@echo "done: source $(ATECH_VENV)/bin/activate, then atech build . in a bench/<part> folder (first build compiles the core)"
.PHONY: atech-standalone atech-mqtt
ATECH_PORT ?= $(firstword $(wildcard /dev/cu.usbmodem*))
atech-standalone: ## ACTIVE head firmware (USB-serial ritual, D44): build; FLASH=1 also uploads over USB data
	firmware/atech-head/standalone/build.sh $(if $(FLASH),upload $(ATECH_PORT))
atech-mqtt: ## MQTT/contract head firmware (next stage, D44): build; FLASH=1 also uploads over USB data
	@set -e; . $(ATECH_VENV)/bin/activate; cd firmware/atech-head; atech build . > /dev/null; \
	if [ -n "$(FLASH)" ]; then sed -i '' 's/^upload_speed = .*/upload_speed = 115200/' build/platformio.ini; \
	  python3 -c 'import pathlib; p = pathlib.Path("build/platformio.ini"); s = p.read_text(); p.write_text(s if "--no-stub" in s else s.replace("upload_flags =\n", "upload_flags =\n    --no-stub\n", 1))'; \
	  pio run -d build -t upload --upload-port $(ATECH_PORT); else echo "built firmware/atech-head (FLASH=1 to upload)"; fi
eval-companion: ## companion persona evals → scorecard: make eval-companion [DRY=1] [ARGS="--surface robot --limit 5"]
	$(if $(DRY),$(RUN) python -m tools.companion_evals.run --dry,$(UV) run --quiet --with google-genai python -m tools.companion_evals.run) $(ARGS)
check: lint test ## lint + test (+ contracts and agents sync checks) — run before pushing
demo: ## ONE command: broker + local API + dashboard + Aino's 16-day record, prints the links [KAIKU_DEMO_PORT=8000]
	@./scripts/demo.sh
demo-reset: ## drop simulated data on the local API and seed Aino's 16 days again (< 30 s; live recordings stay)
	@./demo/reset.sh
live-day: ## what a good vs a rough day today does to Aino's reading (throwaway copy; ARGS="--url http://127.0.0.1:8000 --kind good" posts to a local API)
	$(RUN) python scripts/live_day.py $(ARGS)
