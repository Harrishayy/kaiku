    "prop": "translate",
    "closed": [0, 28],
    "keys": [[0, "pose"], [0.5, [0, 28]], [1, "pose"]],
    "easing": "soft-in-out",
    "modes": {
      "normal": { "duration": 240, "interval": [3000, 7000], "double_chance": 0.1667, "double_gap": 140 },
      "slow": { "duration": 600, "interval": [5000, 9000], "double_chance": 0 },
      "none": null
    }
  },
