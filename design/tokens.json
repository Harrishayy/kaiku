      "mascot-outline": "#D9C3A5",
      "mascot-sparkle": "#E9B44C"
    },
    "dark": {
      "bg": "#221D19",
      "surface": "#2B2520",
      "surface-2": "#352E28",
      "ink": "#F1E7DA",
      "ink-2": "#D3C5B4",
      "muted": "#A8988A",
      "line": "#433A32",
      "clay": "#E08B6C",
      "clay-ink": "#2A1A12",
      "clay-soft": "#4A3027",
      "sage": "#9DBB95",
      "sage-soft": "#2F3A2C",
      "sky": "#9DBBD3",
      "sky-soft": "#2A3640",
      "honey": "#E8BE6A",
      "honey-soft": "#40331C",
      "crisis": "#F2867C",
      "crisis-soft": "#4A2320",
      "crisis-ink": "#2A0F0C",
      "focus": "#8DB8E8",
