    "$semantic": {
      "accent": "clay",
      "going-well": "sage",
      "calm": "sky",
      "worth-a-check-in": "honey",
      "crisis-only": "crisis"
    }
  },
  "glow": {
    "$about": "Chest glow follows local time. Interpolate colour and intensity linearly between stops (wrap at 24h). intensity scales the glow layer's opacity.",
    "stops": [
      { "hour": 0, "name": "night", "color": "#6F82BA", "intensity": 0.45 },
      { "hour": 5, "name": "night", "color": "#6F82BA", "intensity": 0.45 },
      { "hour": 7, "name": "dawn", "color": "#F6AE8A", "intensity": 0.8 },
      { "hour": 10, "name": "day", "color": "#FFD98F", "intensity": 0.9 },
      { "hour": 16, "name": "day", "color": "#FFD98F", "intensity": 0.9 },
      { "hour": 19, "name": "dusk", "color": "#F09A45", "intensity": 0.85 },
      { "hour": 22, "name": "night", "color": "#7F90C6", "intensity": 0.55 }
    ]
  },
  "radius": { "xs": 6, "sm": 10, "md": 16, "lg": 24, "xl": 32, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
  "size": { "tap-min": 44, "icon": 24, "mascot-s": 40, "mascot-m": 96, "mascot-l": 200 },
  "type": {
    "family": {
      "display": { "web": "'Fredoka', 'SF Pro Rounded', ui-rounded, system-ui, sans-serif", "apple": "rounded" },
      "body": { "web": "'Nunito', 'SF Pro Rounded', ui-rounded, system-ui, sans-serif", "apple": "rounded" },
      "mono": { "web": "'DM Mono', ui-monospace, Menlo, monospace", "apple": "monospaced" }
    },
    "google-fonts": "https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600&family=Nunito:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap",
    "scale": {
      "caption": { "size": 13, "line": 18, "weight": 600 },
      "footnote": { "size": 15, "line": 21, "weight": 400 },
      "body": { "size": 17, "line": 25, "weight": 400 },
      "callout": { "size": 19, "line": 27, "weight": 600 },
      "title3": { "size": 22, "line": 28, "weight": 600 },
      "title2": { "size": 28, "line": 34, "weight": 600 },
      "title1": { "size": 34, "line": 40, "weight": 600 },
      "display": { "size": 44, "line": 50, "weight": 500 }
    }
  },
  "motion": {
    "duration": {
      "fast": 300,
      "base": 450,
      "slow": 700,
      "blink": 240,
      "ear-flick": 620,
      "crossfade": 300,
      "idle-breath": 4000,
      "guide-breath": 10000
    },
    "easing": {
      "gentle-out": [0.32, 0.72, 0, 1],
      "soft-in-out": [0.45, 0, 0.25, 1],
      "overshoot": [0.34, 1.36, 0.64, 1],
      "settle": [0.22, 1, 0.36, 1]
    },
    "spring": {
      "gentle": { "response": 0.55, "damping": 0.72 },
      "bouncy": { "response": 0.45, "damping": 0.6 }
    },
    "blink": { "min-interval": 3000, "max-interval": 7000, "double-chance": 0.1667, "double-gap": 140 },
    "idle-breath": { "scale-from": 1.0, "scale-to": 1.025 },
    "guide-breath": { "breaths-per-minute": 6, "inhale-ratio": 0.5, "scale-from": 1.0, "scale-to": 1.08 }
  }
}
